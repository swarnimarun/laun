# Build context is a curated source tree. Unlisted root state is never sent.
**
!package.json
!bun.lock
!tsconfig.json
!tsconfig.base.json
!apps/
!apps/**
!packages/
!packages/**
!vendor/
!vendor/**
!deploy/
!deploy/**

# Private checkout, operator/agent credentials and generated application state.
**/.git
**/.jj
**/.laun-local
**/.laun
**/.aws
**/.ssh
**/.pi
**/.pi-subagents
**/.config
**/.agents
**/.codex
**/.cache
**/.local
**/node_modules
# Application/compiler outputs are disposable; vendor dist is shipped source.
apps/**/dist
packages/**/dist
**/data
**/sessions
**/checkpoints
**/runtime-recovery
**/journal
**/backups
**/exports
**/laun-data
**/laun-bridge-data
**/bridge-data
**/worker-data

# Credential/config values and durable stores, regardless of their source root.
**/.env
**/.env.*
**/*.env
**/worker.env
**/bridge.env
**/auth.json
**/credentials.json
**/access.json
**/keys.json
**/id_rsa
**/id_ed25519
**/*.key
**/*.pem
**/*.crt
**/*.cer
**/*.p12
**/*.pfx
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.db-*
**/*.jsonl
**/*.ndjson
**/*.log
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
**/*.tsbuildinfo
**/.DS_Store

# No broad vendor reinclude follows the private-state rules above.
