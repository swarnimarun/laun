# Unprivileged, Bun-only image for v1 Pi and v2 mediated tool execution.
FROM docker.io/oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d
USER root
ARG PI_VERSION=1.5.2
ENV BUN_INSTALL=/opt/pi
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates fd-find git openssh-client ripgrep \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*
RUN bun add --global --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && rm -f /usr/local/bin/pi \
    && printf '%s\n' '#!/bin/sh' 'exec bun /opt/pi/install/global/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js "$@"' > /usr/local/bin/pi \
    && chmod 755 /usr/local/bin/pi \
    && pi --version
RUN mkdir -p /workspace && chown bun:bun /workspace
USER bun
WORKDIR /workspace
ENV PI_CODING_AGENT_DIR=/tmp/pi-agent
