# --- Release image (deployments only; source builds use it as a local tag) ---
# Pin a release for reproducible deploys (`0.1.0`), or track `latest` for
# effortless upgrades. Changes take effect on `docker compose pull`.
LAUN_TAG=latest
# Override the whole image reference for forks/mirrors (default:
# ghcr.io/swarnimarun/laun).
# LAUN_IMAGE=ghcr.io/example/laun

# --- Required: shared secret for gateway <-> bridge <-> executor ---
GATEWAY_TOKEN=change-me-to-a-long-random-string

# --- Agent key: the human-facing credential for the CLI and browser UI ---
# `laun setup` fills this in and prints it once. The gateway stores only a
# sha256 of it. Empty is fine: mint keys later with `laun keys create`.
LAUN_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
# Your numeric Telegram user id(s), comma-separated. Find yours via @userinfobot.
# Empty = bridge ignores everyone (fail closed).
TELEGRAM_ALLOWLIST_IDS=123456789
# Numeric prefix before ':' in TELEGRAM_BOT_TOKEN (not the secret suffix).
LAUN_TELEGRAM_BOT_ID=
# Explicitly permitted group/forum chat IDs. Private chats use the user allowlist.
TELEGRAM_ALLOWLIST_CHAT_IDS=
# New installs use durable v2 topic/user routing. Set false only for legacy bridge.
LAUN_CONTROL_V2=true
# The v1 sessions API has shared-key semantics; enable only for legacy single-operator clients.
LAUN_LEGACY_API=false
# Optional separate bridge-to-gateway service credential; empty uses GATEWAY_TOKEN.
LAUN_TELEGRAM_BRIDGE_TOKEN=
# Optional stable secret for encrypted connector inbox/outbox persistence.
# Empty derives one from stable bot/bridge credentials. Rotation requires
# deliberate inbox migration; never put this key in a mower/session file.
BRIDGE_INBOX_KEY=

# --- Model (pi --model pattern; verify with `pi --list-models "opencode-go/muse-spark"`) ---
MODEL=opencode-go/muse-spark-1.3-contributor
# MODEL is the legacy v1 default. V2 mower setup lists configured provider/model
# IDs from the pinned Pi catalog. Model credentials belong to the controller,
# never a mower workspace, transcript, sandbox environment or this env file.
# The v1 executor retains its existing PI_CONFIG_DIR host mount.
# Dedicated v2 controller credential directory ON THE VPS, containing auth.json.
# Configure it using a separate Pi login (not a concurrent CLI credential writer).
# Isolated compose requires it explicitly and never creates an empty host path.
PI_CONTROLLER_AUTH_DIR=

# --- V2 mower harness ---
# Off by default. Set true only for trusted source/local development: an
# approved shell retains your host user's authority. Deploy uses OpenShell.
LAUN_TRUSTED_LOCAL=false
# Explicit scripted model demonstration; real providers never fall back to it.
LAUN_DEMO=false
LAUN_LOCAL_CAPACITY=2
MAX_FAMILY_TOKENS=100000
# Off by default; only local test MCP servers should need this exception.
LAUN_MCP_ALLOW_LOOPBACK=false

# --- Ports (host side, loopback only; use an SSH tunnel or TLS proxy) ---
GATEWAY_PORT=8080
EXECUTOR_PORT=8081

# --- Executor ---
PI_BIN=pi
RUN_TIMEOUT_MS=600000
# json = one pi process per message (the proven fallback).
# rpc  = one long-lived pi child per session: steering, abort, and pi's own
#        auto-retry (set_auto_retry), which is what long runs need.
# Flip to rpc only after the health check passes and a smoke run succeeds.
EXECUTOR_MODE=json
# Idle seconds before an rpc child is reaped (minimum 100).
RPC_IDLE_TTL_MS=300000

# --- Gateway limits ---
# Max simultaneously running sessions (0 = unlimited). Past the ceiling,
# new runs are rejected with 429 instead of piling onto the executor.
MAX_CONCURRENT_RUNS=4
# Max counted tokens per session (0 = unlimited). Counted from usage events
# (totalTokens, else input+output); breaching aborts the run.
MAX_SESSION_TOKENS=0
# Resume interrupted runs after a restart (true = resend a continuation;
# false = mark error for a human). Only interruptions younger than the max
# age resume (0 = no limit).
AUTO_RESUME=true
AUTO_RESUME_MAX_AGE_MS=86400000
# Silence ceiling per running session in ms (0 = no sweeper). A live run
# quieter than this gets aborted — but only once the abort verifiably lands.
RUN_STALL_MS=2700000

# --- OpenShell sandbox (v2 controller tools + legacy v1 executor) ---
# Per-session sandboxing. All values below are non-secret (image, paths,
# modes); the only secret (the model key) lives server-side in the provider.
OPENSHELL_ENABLED=false
# This template is the local default. Fresh VPS setup/installer configurations
# select true instead and require the host identity/provider below. An existing
# explicit false is preserved as trusted host execution, without isolation.
# Example only — adjust to your openshell version:
# OPENSHELL_PREFIX=openshell exec --sandbox agent
# Sandbox image launched by OpenShell on the host Docker daemon. Empty = the
# released pi-agent image matching LAUN_TAG. Set pi-agent:local when you build
# deploy/openshell/Dockerfile.pi locally.
OPENSHELL_SANDBOX_IMAGE=
OPENSHELL_POLICY=/openshell/policy.yaml
# Optional operator-reviewed v2 policy path INSIDE the gateway container.
# Empty generates hard-requirement filesystem isolation with no sandbox egress.
# V2 model access runs in the controller; tool/connector access is brokered.
OPENSHELL_V2_POLICY=
OPENSHELL_PROVIDER=laun-model
# auto: advisor proposals for network egress grant themselves (proven live:
# deny → propose → approve → retry succeeds, audited in rule history).
# manual holds everything for review. Filesystem denials stay denied either way.
OPENSHELL_APPROVAL_MODE=manual
# Isolated VPS setup selects docker-compose.openshell.yml automatically when
# OPENSHELL_ENABLED=true. Set this to the OpenShell config directory ON THAT
# HOST, containing gateways/<name>/mtls/{ca.crt,tls.crt,tls.key}. Local setup
# needs none of these paths or certificates while OpenShell is disabled.
OPENSHELL_CONFIG_DIR=
OPENSHELL_GATEWAY_NAME=openshell
OPENSHELL_SDK_GATEWAY=https://host.openshell.internal:17670
# Current CLI identity directory derived from the endpoint; change together
# with the endpoint if using another gateway URL; use its CLI identity directory.
OPENSHELL_GATEWAY_CONFIG_ID=https___host.openshell.internal_17670
# Delete stopped sandboxes past this idle age (default 7d).
OPENSHELL_SANDBOX_MAX_IDLE_MS=604800000

# --- OpenShell provider + scoped auto-approval (bring-up only) ---
# The bring-up script (deploy/openshell/install-and-verify.sh) reads these
# from the ENVIRONMENT, never from this file -- they are documented here so a
# commented shape exists to copy. Never commit real keys.
# MODEL_API_KEY=<paste-in-shell-only, never committed>
# MODEL_PROVIDER=laun-model
# MODEL_PROVIDER_TYPE=laun-model
# OS_APPROVAL_MODE=auto

# --- Bridge ---
BRIDGE_POLL_MS=2000

# --- TLS upgrade path (Caddy; tunnel stays the default, see deploy/tls.md) ---
# Uncomment and fill in to enable the caddy service in docker-compose.yml.
# DOMAIN is the hostname Caddy gets a cert for; ACME_EMAIL is the
# Let's Encrypt contact for expiry/issue notices.
# DOMAIN=example.com
# ACME_EMAIL=you@example.com
