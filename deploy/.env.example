# --- Required: shared secret for gateway <-> bridge <-> executor ---
GATEWAY_TOKEN=change-me-to-a-long-random-string

# --- Agent key: the human-facing credential for the CLI and browser UI ---
# `cloudbear setup` fills this in and prints it once. The gateway stores only a
# sha256 of it. Empty is fine: mint keys later with `cloudbear keys create`.
CLOUDBEAR_KEY

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
# Your numeric Telegram user id(s), comma-separated. Find yours via @userinfobot.
# Empty = bridge ignores everyone (fail closed).
TELEGRAM_ALLOWLIST_IDS=123456789

# --- Model (pi --model pattern; verify with `pi --list-models "opencode-go/muse-spark"`) ---
MODEL=opencode-go/muse-spark-1.3-contributor
# Auth is NOT a key in this file: pi reads ~/.pi/agent/auth.json, which is mounted
# from this host into the executor container (see docker-compose.yml). Log in on the
# host the same way you do locally, then verify: pi --list-models "opencode-go/muse-spark"
# Never commit real keys.

# --- Ports (host side) ---
GATEWAY_PORT=8080
EXECUTOR_PORT=8081

# --- Executor ---
PI_BIN=pi
RUN_TIMEOUT_MS=600000
# json = one pi process per message (the proven fallback).
# rpc  = one long-lived pi child per session: steering, abort, and pi's own
#        auto-retry (set_auto_retry), which is what long runs need.
# Flip to rpc only after the health check passes and a smoke run succeeds.
EXECUTOR_MODE=json
# Idle seconds before an rpc child is reaped (minimum 100).
RPC_IDLE_TTL_MS=300000

# --- OpenShell sandbox (executor only) ---
# Keep false until `openshell` works on the VPS, then set true + prefix.
# Confirm the exact exec syntax with `openshell --help` (version-dependent).
OPENSHELL_ENABLED=false
# Example only — adjust to your openshell version:
# OPENSHELL_PREFIX=openshell exec --sandbox agent

# --- OpenShell provider + scoped auto-approval (bring-up only) ---
# The bring-up script (deploy/openshell/install-and-verify.sh) reads these
# from the ENVIRONMENT, never from this file -- they are documented here so a
# commented shape exists to copy. Never commit real keys.
# MODEL_API_KEY=<paste-in-shell-only, never committed>
# MODEL_PROVIDER=cloudbear-model
# MODEL_PROVIDER_TYPE=cloudbear-model
# OS_APPROVAL_MODE=auto

# --- Bridge ---
BRIDGE_POLL_MS=2000
