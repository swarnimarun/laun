# --- Required: shared secret for gateway <-> bridge <-> executor ---
GATEWAY_TOKEN=change-me-to-a-long-random-string

# --- Agent key: the human-facing credential for the CLI and browser UI ---
# `laun setup` fills this in and prints it once. The gateway stores only a
# sha256 of it. Empty is fine: mint keys later with `laun keys create`.
LAUN_KEY

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
# Your numeric Telegram user id(s), comma-separated. Find yours via @userinfobot.
# Empty = bridge ignores everyone (fail closed).
TELEGRAM_ALLOWLIST_IDS=123456789

# --- Model (pi --model pattern; verify with `pi --list-models "opencode-go/muse-spark"`) ---
MODEL=opencode-go/muse-spark-1.3-contributor
# Auth is NOT a key in this file: pi reads ~/.pi/agent/auth.json, which is mounted
# from this host into the executor container (see docker-compose.yml). Log in on the
# host the same way you do locally, then verify: pi --list-models "opencode-go/muse-spark"
# Never commit real keys.

# --- Ports (host side) ---
GATEWAY_PORT=8080
EXECUTOR_PORT=8081

# --- Executor ---
PI_BIN=pi
RUN_TIMEOUT_MS=600000
# json = one pi process per message (the proven fallback).
# rpc  = one long-lived pi child per session: steering, abort, and pi's own
#        auto-retry (set_auto_retry), which is what long runs need.
# Flip to rpc only after the health check passes and a smoke run succeeds.
EXECUTOR_MODE=json
# Idle seconds before an rpc child is reaped (minimum 100).
RPC_IDLE_TTL_MS=300000

# --- Gateway limits ---
# Max simultaneously running sessions (0 = unlimited). Past the ceiling,
# new runs are rejected with 429 instead of piling onto the executor.
MAX_CONCURRENT_RUNS=4
# Max counted tokens per session (0 = unlimited). Counted from usage events
# (totalTokens, else input+output); breaching aborts the run.
MAX_SESSION_TOKENS=0

# --- OpenShell sandbox (executor only) ---
# Per-session sandboxing. All values below are non-secret (image, paths,
# modes); the only secret (the model key) lives server-side in the provider.
OPENSHELL_ENABLED=false
# Example only — adjust to your openshell version:
# OPENSHELL_PREFIX=openshell exec --sandbox agent
OPENSHELL_SANDBOX_IMAGE=pi-agent:local
OPENSHELL_POLICY=/openshell/policy.yaml
OPENSHELL_PROVIDER=laun-model
# auto: advisor proposals for network egress grant themselves (proven live:
# deny → propose → approve → retry succeeds, audited in rule history).
# manual holds everything for review. Filesystem denials stay denied either way.
OPENSHELL_APPROVAL_MODE=auto
# SDK transport back to the gateway API (see compose extra_hosts + mtls
# volume). The gateway cert carries SAN host.openshell.internal, so
# verification stays on; client mTLS still authenticates.
OPENSHELL_SDK_GATEWAY=https://host.openshell.internal:17670
OPENSHELL_SDK_INSECURE=false
OPENSHELL_SDK_CLIENT_CERT_FILE=/openshell-mtls/tls.crt
OPENSHELL_SDK_CLIENT_KEY_FILE=/openshell-mtls/tls.key
OPENSHELL_SDK_CA_FILE=/openshell-mtls/ca.crt
# Delete stopped sandboxes past this idle age (default 7d).
OPENSHELL_SANDBOX_MAX_IDLE_MS=604800000

# --- OpenShell provider + scoped auto-approval (bring-up only) ---
# The bring-up script (deploy/openshell/install-and-verify.sh) reads these
# from the ENVIRONMENT, never from this file -- they are documented here so a
# commented shape exists to copy. Never commit real keys.
# MODEL_API_KEY=<paste-in-shell-only, never committed>
# MODEL_PROVIDER=laun-model
# MODEL_PROVIDER_TYPE=laun-model
# OS_APPROVAL_MODE=auto

# --- Bridge ---
BRIDGE_POLL_MS=2000

# --- TLS upgrade path (Caddy; tunnel stays the default, see deploy/tls.md) ---
# Uncomment and fill in to enable the caddy service in docker-compose.yml.
# DOMAIN is the hostname Caddy gets a cert for; ACME_EMAIL is the
# Let's Encrypt contact for expiry/issue notices.
# DOMAIN=example.com
# ACME_EMAIL=you@example.com
