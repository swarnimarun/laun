{
  "name": "cloudbear",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted remote agent executor: Pi-first, OpenShell policy sandbox, Telegram bridge. Single VPS, 24/7.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun x tsc -b",
    "typecheck": "bun x tsc -b",
    "test": "bun test ./packages/protocol/src ./packages/policy/src ./apps/executor/src ./apps/gateway/src ./apps/telegram-bridge/src",
    "dev:gateway": "bun run build && bun --hot apps/gateway/src/index.ts",
    "dev:executor": "bun run build && bun --hot apps/executor/src/index.ts",
    "dev:bridge": "bun run build && bun --hot apps/telegram-bridge/src/index.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "bun-types": "latest"
  }
}
